#!/bin/sh
# Fake `zfs`: see test_fixtures/fakebin/README.md. Not a real backend -- never touches any real pool.
set -eu
state="${FAKE_SG_STATE:?FAKE_SG_STATE not set}"
snap_file="$state/zfs_snapshots"
touch "$snap_file"

fail_if_missing() {
    ds="$1"
    if [ -f "$state/zfs_missing_dataset" ] && [ "$(cat "$state/zfs_missing_dataset")" = "$ds" ]; then
        echo "cannot open '$ds': dataset does not exist" >&2
        exit 1
    fi
}

cmd="$1"; shift

case "$cmd" in
    list)
        dataset=""
        for a in "$@"; do dataset="$a"; done
        fail_if_missing "$dataset"
        joined=" $* "
        case "$joined" in
            *" used,avail "*)
                printf '%s\t%s\n' "$(cat "$state/zfs_used")" "$(cat "$state/zfs_avail")"
                ;;
            *)
                awk -F'@' -v d="$dataset" '$1==d || index($1, d "/")==1 {print}' "$snap_file"
                ;;
        esac
        ;;
    snapshot)
        name="$1"
        fail_if_missing "${name%%@*}"
        echo "$name" >> "$snap_file"
        ;;
    destroy)
        name="$1"
        fail_if_missing "${name%%@*}"
        grep -vFx "$name" "$snap_file" > "$snap_file.tmp" 2>/dev/null || true
        mv "$snap_file.tmp" "$snap_file"
        ;;
    *)
        echo "fake zfs: unsupported subcommand: $cmd" >&2
        exit 2
        ;;
esac
