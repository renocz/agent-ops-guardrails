#!/bin/sh
# Fake `lvcreate`: see test_fixtures/fakebin/README.md. Not a real backend -- creates no real LV.
set -eu
state="${FAKE_SG_STATE:?FAKE_SG_STATE not set}"
snap_file="$state/lvm_snapshots"
touch "$snap_file"
name=""
prev=""
origin=""
for a in "$@"; do
    if [ "$prev" = "-n" ]; then
        name="$a"
    fi
    prev="$a"
    origin="$a"
done
case "$name" in
    *@*)
        echo "lvcreate: new logical volume name \"$name\" is invalid" >&2
        exit 3
        ;;
esac
echo "${origin}@${name}" >> "$snap_file"
